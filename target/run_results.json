{"metadata": {"dbt_schema_version": "https://schemas.getdbt.com/dbt/run-results/v6.json", "dbt_version": "1.12.6", "generated_at": "2026-10-23T13:57:55.469305Z", "invocation_id": "4fb8523d-5ff2-4283-b892-00a2d0ae85a7", "invocation_started_at": "2026-10-23T13:57:53.533439Z", "env": {}}, "results": [{"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-23T13:57:55.298864Z", "completed_at": "2026-10-23T13:57:55.304830Z"}, {"name": "execute", "started_at": "2026-10-23T13:57:55.304830Z", "completed_at": "2026-10-23T13:57:55.304830Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.009027957916259766, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.shop.stg_orders", "compiled": true, "compiled_code": "-- Staging: give each column its real type and repair what can be repaired.\n-- No row is removed here.\nselect\n    try_cast(src.order_id as integer)                                         as order_id,\n    try_strptime(src.order_date, '%Y-%m-%d')::date                            as order_date,\n    src.customer_id                                                           as customer_id,\n    upper(left(trim(src.country), 1)) || lower(substr(trim(src.country), 2))  as country,\n    src.product                                                               as product,\n    try_cast(src.quantity as integer)                                         as quantity,\n    try_cast(src.unit_price as decimal(10, 2))                                as unit_price,\n    src._row_number                                                           as _row_number,\n    src._loaded_at                                                            as _loaded_at\nfrom \"warehouse\".\"raw\".\"orders\" as src", "relation_name": "\"warehouse\".\"main\".\"stg_orders\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-23T13:57:55.307880Z", "completed_at": "2026-10-23T13: