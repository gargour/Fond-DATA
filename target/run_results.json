ers_clean\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-23T13:57:55.321348Z", "completed_at": "2026-10-23T13:57:55.323547Z"}, {"name": "execute", "started_at": "2026-10-23T13:57:55.324545Z", "completed_at": "2026-10-23T13:57:55.324545Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.0042572021484375, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.shop.orders_rejected", "compiled": true, "compiled_code": "select *\nfrom \"warehouse\".\"main\".\"int_orders_checked\"\nwhere reject_reason is not null", "relation_name": "\"warehouse\".\"main\".\"orders_rejected\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-23T13:57:55.327545Z", "completed_at": "2026-10-23T13:57:55.329551Z"}, {"name": "execute", "started_at": "2026-10-23T13:57:55.330583Z", "completed_at": "2026-10-23T13:57:55.330583Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.004038333892822266, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.shop.assert_reject_rate_below_20_percent", "compiled": true, "compiled_code": "-- Stop the chain if more than 20 % of the rows were rejected.\n-- A data test passes when it returns no rows.\nselect\n    count(*) filter (where reject_reason is not null) as n_rejected,\n    count(*) as n_total\nfrom \"warehouse\".\"main\".\"int_orders_checked\"\nhaving count(*) filter (where reject_reason is not null) > 0.20 * count(*)", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-23T13:57:55.334596Z", "completed_at": "2026-10-23T13:57:55.337595Z"}, {"name": "execute", "started_at": "2026-10-23T13:57:55.338596Z", "completed_at": "2026-10-23T13:57:55.338596Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.004992246627807617, "adapter_respon